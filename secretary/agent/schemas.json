          },
          "client": {
            "type": "string",
            "description": "発注者"
          },
          "location": {
            "type": "string",
            "description": "工事場所"
          },
          "phase": {
            "type": "string",
            "description": "フェーズ"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "description": ""
