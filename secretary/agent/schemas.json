            "description": "略称・工事番号・表記ゆれ"
          }
        },
        "required": [
          "name",
          "client",
          "location",
          "phase",
          "aliases"
        ],
        "additionalProperties": false
      },
      "category": {
        "type": "string",
        "enum": [
          "発注者対応",
          "設計・監理者対応",
          "行政・官公庁",
          "協力会社・発注",
          "工程・現場調整",
          "安全・品質",
          "近隣対応",
          "見積・契約・出来高",
          "社内",
          "情報共有",
          "その他"
